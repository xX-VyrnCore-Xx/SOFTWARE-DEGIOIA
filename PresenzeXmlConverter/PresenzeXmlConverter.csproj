<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\assets\PresenzeXmlConverter.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PresenzeFlow</AssemblyName>
    <RootNamespace>PresenzeXmlConverter</RootNamespace>
    <Version>1.11.0</Version>
    <AssemblyVersion>1.11.0.0</AssemblyVersion>
    <FileVersion>1.11.0.0</FileVersion>
    <InformationalVersion>1.11.0</InformationalVersion>
    <Product>PresenzeFlow</Product>
    <AssemblyTitle>PresenzeFlow</AssemblyTitle>
    <Description>Conversione locale di presenze Excel in XML TRRIPW per Zucchetti.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PresenzeXmlConverter.Tests" />
  </ItemGroup>

</Project>