<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\assets\PresenzeXmlConverter.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PresenzeFlow</AssemblyName>
    <RootNamespace>PresenzeXmlConverter</RootNamespace>
    <Version>1.29.1</Version>
    <AssemblyVersion>1.29.1.0</AssemblyVersion>
    <FileVersion>1.29.1.0</FileVersion>
    <InformationalVersion>1.29.1</InformationalVersion>
    <Company>DeGioia</Company>
    <Authors>DeGioia</Authors>
    <Copyright>© DeGioia</Copyright>
    <Product>Vyrn Presence</Product>
    <AssemblyTitle>Vyrn Presence</AssemblyTitle>
    <Description>Conversione locale di presenze Excel in XML TRRIPW per Zucchetti.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Avvio più rapido: l'interfaccia WinForms è molta e il JIT a freddo è la
         voce più pesante dell'apertura. ReadyToRun compila in anticipo il codice
         gestito, quindi la finestra non aspetta la compilazione al primo
         utilizzo. Vale solo per il publish (la Release); la compilazione di
         sviluppo non cambia. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Un pacchetto single-file porta con sé le risorse localizzate di ogni
         dipendenza: tenerle tutte gonfia il file (e quindi la prima analisi di
         Windows Defender) senza che l'app le usi. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PresenzeXmlConverter.Tests" />
  </ItemGroup>

</Project>